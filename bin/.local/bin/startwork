#!/usr/bin/env bash
# startwork — spin up all project sessions and attach

setup_session() {
    local name="$1"
    local path="$2"
    mkdir -p "$path"
    if ! tmux has-session -t="$name" 2>/dev/null; then
        tmux new-session -ds "$name" -c "$path"
        tmux rename-window -t "$name:1" "nvim"
        tmux new-window -t "$name" -n "server" -c "$path"
        tmux new-window -t "$name" -n "claude" -c "$path"
        tmux select-window -t "$name:1"
    fi
}

setup_session "toastyvault" "$HOME/work/toastystation/toasty-vault"
setup_session "bunker" "$HOME/work/fulflld/fulflld-bunker"
setup_session "notes" "$HOME/work/notes"

if [[ -z $TMUX ]]; then
    tmux attach-session -t toastyvault
else
    tmux switch-client -t toastyvault
fi
