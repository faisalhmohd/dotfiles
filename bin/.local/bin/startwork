#!/usr/bin/env bash
# startwork — spin up all project sessions and attach

declare -A sessions=(
    ["toastyvault"]="$HOME/work/toastystation/toasty-vault"
    ["bunker"]="$HOME/work/fulflld/fulflld-bunker"
    ["notes"]="$HOME/work/notes"
)

declare -a order=("toastyvault" "bunker" "notes")

for name in "${order[@]}"; do
    path="${sessions[$name]}"
    mkdir -p "$path"

    if ! tmux has-session -t="$name" 2>/dev/null; then
        tmux new-session -ds "$name" -c "$path"
        tmux rename-window -t "$name:1" "nvim"
        tmux new-window -t "$name" -n "server" -c "$path"
        tmux new-window -t "$name" -n "claude" -c "$path"
        tmux select-window -t "$name:1"
    fi
done

if [[ -z $TMUX ]]; then
    tmux attach-session -t toastyvault
else
    tmux switch-client -t toastyvault
fi
